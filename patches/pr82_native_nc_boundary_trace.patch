+SUBROUTINE pr82_nc_boundary(stage,itimestep,rkstep,xtime,ims,ime,jms,jme,kms,kme,qnc,qc)
+  implicit none
+  character(len=*),intent(in)::stage
+  integer,intent(in)::itimestep,rkstep,ims,ime,jms,jme,kms,kme
+  real,intent(in)::xtime,qnc(ims:ime,kms:kme,jms:jme),qc(ims:ime,kms:kme,jms:jme)
+  integer::u
+  integer::qnc_bits,qc_bits
+  if (4<ims .or. 4>ime .or. 2<jms .or. 2>jme .or. 22<kms .or. 22>kme) return
+  qnc_bits=transfer(qnc(4,22,2),qnc_bits)
+  qc_bits=transfer(qc(4,22,2),qc_bits)
+  open(newunit=u,file='pr82_nc_boundaries.raw',status='unknown',position='append',action='write')
+  write(u,'(A,1X,I0,1X,I0,1X,I0,1X,I0,1X,I0,1X,ES24.16,1X,Z8.8,1X,Z8.8,1X,ES24.16,1X,ES24.16)') &
+       trim(stage),itimestep,rkstep,4,2,22,xtime,qnc_bits,qc_bits,qnc(4,22,2),qc(4,22,2)
+  close(u)
+END SUBROUTINE pr82_nc_boundary
