+   contains
+
+    pure function number_conversion_error_class(input_value, dry_density, result_value, direction) result(error_class)
+      real, intent(in) :: input_value, dry_density, result_value
+      integer, intent(in) :: direction
+      character(len=24) :: error_class
+      error_class = 'UNCLASSIFIED'
+      if (.not. ieee_is_finite(input_value)) then
+        error_class = 'NONFINITE_INPUT'
+      else if (.not. ieee_is_finite(dry_density)) then
+        error_class = 'NONFINITE_DENSITY'
+      else if (input_value < 0.0) then
+        error_class = 'NEGATIVE_INPUT'
+      else if (dry_density <= 0.0) then
+        error_class = 'NONPOSITIVE_DENSITY'
+      else if (direction == 1 .and. dry_density > 1.0 .and. &
+               real(input_value,8) > real(huge(input_value),8) / real(dry_density,8)) then
+        error_class = 'OVERFLOW_GUARD'
+      else if (direction == 2 .and. dry_density < 1.0 .and. &
+               real(input_value,8) > real(huge(input_value),8) * real(dry_density,8)) then
+        error_class = 'OVERFLOW_GUARD'
+      else if (.not. ieee_is_finite(result_value)) then
+        error_class = 'NONFINITE_RESULT'
+      else if (input_value > 0.0 .and. result_value == 0.0) then
+        error_class = 'POSITIVE_TO_ZERO'
+      endif
+    end function number_conversion_error_class
+
+    subroutine log_number_conversion_rejection(species, stage, i, j, k, input_value, &
+                                                dry_density, result_value, direction, &
+                                                mxcsr_before, mxcsr_after, thread_before, thread_after)
+      character(len=*), intent(in) :: species, stage
+      integer, intent(in) :: i, j, k, direction
+      real, intent(in) :: input_value, dry_density, result_value
+      integer(c_int), intent(in) :: mxcsr_before, mxcsr_after, thread_before, thread_after
+      integer :: unit, io_status
+      character(len=24) :: error_class
+      error_class = number_conversion_error_class(input_value, dry_density, result_value, direction)
+      open(newunit=unit, file='number_basis_rejection.raw', status='unknown', &
+           position='append', action='write', iostat=io_status)
+      if (io_status == 0) then
+        write(unit,'(A,",",A,",",A,3(",",I0),5(",",Z8.8),2(",",I0),",",A)') &
+             'NUMBER_BASIS_REJECT', species, stage, i, j, k, &
+             transfer(input_value,0), transfer(dry_density,0), transfer(result_value,0), &
+             mxcsr_before, mxcsr_after, thread_before, thread_after, trim(error_class)
+        close(unit)
+      endif
+    end subroutine log_number_conversion_rejection
+
    end subroutine kdm6
 
