+  SUBROUTINE pr85_apply_ksas_source(qrate,qbase,nbase,mbar,ntend,nrate,effective_mbar,status)
+    USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
+    IMPLICIT NONE
+    REAL, INTENT(IN) :: qrate,qbase,nbase,mbar
+    REAL, INTENT(INOUT) :: ntend
+    REAL, INTENT(OUT) :: nrate,effective_mbar
+    INTEGER, INTENT(OUT) :: status
+    INTEGER, PARAMETER :: dp = SELECTED_REAL_KIND(15,307)
+    REAL(KIND=dp) :: dq,dqbase,dnbase,dmbar,dntend,dnrate,dupdated,deffective_mbar
+    REAL :: nrate32,updated32
+
+    status = 0
+    nrate = 0.0
+    effective_mbar = mbar
+    IF (.NOT. ieee_is_finite(qrate) .OR. .NOT. ieee_is_finite(qbase) .OR. &
+        .NOT. ieee_is_finite(nbase) .OR. .NOT. ieee_is_finite(mbar) .OR. &
+        .NOT. ieee_is_finite(ntend) .OR. qbase < 0.0 .OR. nbase < 0.0 .OR. mbar <= 0.0) THEN
+      status = 1
+      RETURN
+    END IF
+
+    dq = REAL(qrate,KIND=dp)
+    dqbase = REAL(qbase,KIND=dp)
+    dnbase = REAL(nbase,KIND=dp)
+    dmbar = REAL(mbar,KIND=dp)
+    IF (dq > 0.0_dp) THEN
+      dnrate = dq / dmbar
+    ELSE IF (dq < 0.0_dp) THEN
+      IF (dqbase <= 0.0_dp .OR. dnbase <= 0.0_dp) THEN
+        status = 2
+        RETURN
+      END IF
+      dnrate = dq * dnbase / dqbase
+      deffective_mbar = dqbase / dnbase
+    ELSE
+      RETURN
+    END IF
+    IF (dq > 0.0_dp) deffective_mbar = dmbar
+    IF (.NOT. ieee_is_finite(deffective_mbar) .OR. deffective_mbar <= 0.0_dp .OR. &
+        deffective_mbar > REAL(HUGE(effective_mbar),KIND=dp)) THEN
+      status = 5
+      RETURN
+    END IF
+    effective_mbar = REAL(deffective_mbar)
+
+    dntend = REAL(ntend,KIND=dp)
+    dupdated = dntend + dnrate
+    IF (.NOT. ieee_is_finite(dnrate) .OR. .NOT. ieee_is_finite(dupdated) .OR. &
+        ABS(dnrate) > REAL(HUGE(nrate32),KIND=dp) .OR. &
+        ABS(dupdated) > REAL(HUGE(updated32),KIND=dp)) THEN
+      status = 3
+      RETURN
+    END IF
+    nrate32 = REAL(dnrate)
+    updated32 = REAL(dupdated)
+    IF (dnrate /= 0.0_dp .AND. nrate32 == 0.0) THEN
+      status = 4
+      RETURN
+    END IF
+    nrate = nrate32
+    ntend = updated32
+  END SUBROUTINE pr85_apply_ksas_source
+
 END MODULE module_first_rk_step_part2
 
