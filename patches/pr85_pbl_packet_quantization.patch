+!-------------------------------------------------------------------------------
+   logical function pr85_packet_roundtrip(qbase,nbase,qrate,nrate, &
+                                         qlegacy,nlegacy,dt,mmin,mmax)
+! Reject a zero-base import only when the exact shared solve is PSD-valid but
+! a REAL32 tendency followed by an RK3 update stores an invalid pair.
+     use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+     implicit none
+     real, intent(in) :: qbase,nbase
+     real(kind=8), intent(in) :: qrate,nrate,qlegacy,nlegacy,dt,mmin,mmax
+     real(kind=8), parameter :: rk_fraction(3)=[1.d0/3.d0,0.5d0,1.d0]
+     real(kind=8) :: qexact,nexact,qstored,nstored,mean_exact,mean_stored
+     real(kind=8) :: lower_tol,upper_tol
+     integer :: stage
+     pr85_packet_roundtrip=.false.
+     if(qbase.ne.0. .or. nbase.ne.0.) return
+     if(qrate.le.0.d0 .or. nrate.le.0.d0) return
+     lower_tol=8.d0*abs(real(spacing(real(mmin)),8))
+     upper_tol=8.d0*abs(real(spacing(real(mmax)),8))
+     do stage=1,3
+       qexact=real(qbase,8)+rk_fraction(stage)*dt*qrate
+       nexact=real(nbase,8)+rk_fraction(stage)*dt*nrate
+       if(.not.ieee_is_finite(qexact).or..not.ieee_is_finite(nexact)) return
+       if(qexact.le.0.d0.or.nexact.le.0.d0) return
+       mean_exact=qexact/nexact
+       if(mean_exact.lt.mmin-lower_tol.or.mean_exact.gt.mmax+upper_tol) return
+       qstored=real(real(qbase,8)+rk_fraction(stage)*dt*qlegacy)
+       nstored=real(real(nbase,8)+rk_fraction(stage)*dt*nlegacy)
+       if(.not.ieee_is_finite(qstored).or..not.ieee_is_finite(nstored)) then
+         pr85_packet_roundtrip=.true.
+         return
+       endif
+       if(qstored.le.0.d0.or.nstored.le.0.d0) then
+         pr85_packet_roundtrip=.true.
+         return
+       endif
+       mean_stored=qstored/nstored
+       if(mean_stored.lt.mmin-lower_tol.or.mean_stored.gt.mmax+upper_tol) then
+         pr85_packet_roundtrip=.true.
+         return
+       endif
+     enddo
+   end function pr85_packet_roundtrip
+!-------------------------------------------------------------------------------
+!
+!-------------------------------------------------------------------------------
+   subroutine pr85_tridin64(kts,kte,cl,cm,cu,rhs,sol,cprime,dprime,denom)
+! Solve the REAL32 common tridiagonal system in REAL64 without changing it.
+     implicit none
+     integer, intent(in) :: kts,kte
+     real(kind=8), intent(in) :: cl(kts:kte),cm(kts:kte),cu(kts:kte)
+     real(kind=8), intent(in) :: rhs(kts:kte)
+     real(kind=8), intent(out) :: sol(kts:kte),cprime(kts:kte),dprime(kts:kte)
+     real(kind=8), intent(out) :: denom
+     integer :: kk
+     denom=cm(kts)
+     cprime(kts)=cu(kts)/denom
+     dprime(kts)=rhs(kts)/denom
+     do kk=kts+1,kte
+       denom=cm(kk)-cl(kk)*cprime(kk-1)
+       if(kk.lt.kte) cprime(kk)=cu(kk)/denom
+       dprime(kk)=(rhs(kk)-cl(kk)*dprime(kk-1))/denom
+     enddo
+     sol(kte)=dprime(kte)
+     do kk=kte-1,kts,-1
+       sol(kk)=dprime(kk)-cprime(kk)*sol(kk+1)
+     enddo
+   end subroutine pr85_tridin64
