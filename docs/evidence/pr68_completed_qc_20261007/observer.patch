+SUBROUTINE pr68_capture_qc_stage(stage,rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte,qc,tendency)
+  implicit none
+  character(len=*),intent(in)::stage
+  integer,intent(in)::rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte
+  real,intent(in)::qc(ims:ime,kms:kme,jms:jme),tendency(ims:ime,kms:kme,jms:jme)
+  integer,save::target_count=0
+  integer,save::target_i(23494),target_j(23494),target_k(23494)
+  logical,save::targets_loaded=.false.
+  integer::u,ioerr,n,i,j,k,m
+  if(rkstep<1.or.rkstep>3)return
+  if(.not.targets_loaded)then
+    open(newunit=u,file='pr68_target_qc_coords.txt',status='old',action='read',iostat=ioerr)
+    if(ioerr/=0)call wrf_error_fatal3('<stdin>',0,'PR68 target coordinate file unavailable')
+    read(u,*,iostat=ioerr)n
+    if(ioerr/=0.or.n/=23494)call wrf_error_fatal3('<stdin>',0,'PR68 target coordinate count invalid')
+    do m=1,n
+      read(u,*,iostat=ioerr)target_i(m),target_j(m),target_k(m)
+      if(ioerr/=0)call wrf_error_fatal3('<stdin>',0,'PR68 target coordinate row invalid')
+    enddo
+    close(u)
+    target_count=n
+    targets_loaded=.true.
+  endif
+!$OMP CRITICAL (pr68_qc_stage_log)
+  open(newunit=u,file='pr68_qc_stages.raw',status='unknown',position='append',action='write')
+  do m=1,target_count
+    i=target_i(m);j=target_j(m);k=target_k(m)
+    if(i<its.or.i>ite.or.j<jts.or.j>jte.or.k<kts.or.k>kte)cycle
+    write(u,'(A,1X,A,1X,4(I0,1X),2(ES24.16,1X))')'QC_STAGE',trim(stage),rkstep,i,j,k,qc(i,k,j),tendency(i,k,j)
+  enddo
+  close(u)
+!$OMP END CRITICAL (pr68_qc_stage_log)
+END SUBROUTINE pr68_capture_qc_stage
