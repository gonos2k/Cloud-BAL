+    subroutine kdm6_rain_process_fraction(q_fixed,q_process,n_fixed,n_process, &
+         bg_fixed,bg_process,t_fixed,t_process,density,pidnr,qmin,ncmin, &
+         qcrmin,dmr,lambda_min,lambda_max,rho_min,rho_max,pidnc,dmc, &
+         lambda_c_min,lambda_c_max,pidni,dmi,lambda_i_min,lambda_i_max, &
+         fraction,feasible)
+      use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+      implicit none
+      real, intent(in) :: q_fixed(5),q_process(5),n_fixed(3),n_process(3)
+      real, intent(in) :: bg_fixed,bg_process,t_fixed,t_process,density,pidnr
+      real, intent(in) :: qmin,ncmin,qcrmin,dmr,lambda_min,lambda_max,rho_min,rho_max
+      real, intent(in) :: pidnc,dmc,lambda_c_min,lambda_c_max
+      real, intent(in) :: pidni,dmi,lambda_i_min,lambda_i_max
+      real, intent(out) :: fraction
+      logical, intent(out) :: feasible
+      real :: alpha_min,alpha_max,n_per_q_min,n_per_q_max
+      real :: n_per_q_c_min,n_per_q_c_max,n_per_q_i_min,n_per_q_i_max
+      real :: q_trial(5),n_trial(3),bg_trial,t_trial
+      integer :: i,step
+
+      feasible=.false.
+      fraction=0.0
+      if (.not.all(ieee_is_finite([q_fixed,q_process,n_fixed,n_process, &
+          bg_fixed,bg_process,t_fixed,t_process,density,pidnr,pidnc,pidni, &
+          qmin,ncmin,qcrmin,dmr,dmc,dmi,lambda_min,lambda_max, &
+          lambda_c_min,lambda_c_max,lambda_i_min,lambda_i_max,rho_min,rho_max]))) return
+      if (density.le.0.0 .or. pidnr.le.0.0 .or. pidnc.le.0.0 .or. pidni.le.0.0 .or. &
+          lambda_min.le.0.0 .or. lambda_max.lt.lambda_min .or. &
+          lambda_c_min.le.0.0 .or. lambda_c_max.lt.lambda_c_min .or. &
+          lambda_i_min.le.0.0 .or. lambda_i_max.lt.lambda_i_min .or. &
+          rho_min.le.0.0 .or. rho_max.lt.rho_min .or. &
+          qmin.lt.0.0 .or. ncmin.lt.0.0 .or. qcrmin.lt.0.0 .or. &
+          dmr.le.0.0 .or. dmc.le.0.0 .or. dmi.le.0.0) return
+
+      alpha_min=0.0
+      alpha_max=1.0
+      feasible=.true.
+      do i=1,5
+        call constrain_process_margin(q_fixed(i),q_process(i), &
+             alpha_min,alpha_max,feasible)
+      enddo
+      do i=1,3
+        call constrain_process_margin(n_fixed(i),n_process(i), &
+             alpha_min,alpha_max,feasible)
+      enddo
+      call constrain_process_margin(bg_fixed,bg_process,alpha_min,alpha_max,feasible)
+      n_per_q_min=density*lambda_min**dmr/pidnr
+      n_per_q_max=density*lambda_max**dmr/pidnr
+      n_per_q_c_min=density*lambda_c_min**dmc/pidnc
+      n_per_q_c_max=density*lambda_c_max**dmc/pidnc
+      n_per_q_i_min=density*lambda_i_min**dmi/pidni
+      n_per_q_i_max=density*lambda_i_max**dmi/pidni
+      if (.not.all(ieee_is_finite([n_per_q_min,n_per_q_max,n_per_q_c_min, &
+          n_per_q_c_max,n_per_q_i_min,n_per_q_i_max]))) then
+        feasible=.false.
+        return
+      endif
+      call constrain_process_margin(n_fixed(3)-n_per_q_min*q_fixed(3), &
+           n_process(3)-n_per_q_min*q_process(3),alpha_min,alpha_max,feasible)
+      call constrain_process_margin(n_per_q_max*q_fixed(3)-n_fixed(3), &
+           n_per_q_max*q_process(3)-n_process(3),alpha_min,alpha_max,feasible)
+      q_trial=q_fixed+alpha_max*q_process
+      n_trial=n_fixed+alpha_max*n_process
+      if (q_trial(1).gt.qmin .and. n_trial(1).gt.0.0) then
+        call constrain_process_margin(n_fixed(1)-n_per_q_c_min*q_fixed(1), &
+             n_process(1)-n_per_q_c_min*q_process(1), &
+             alpha_min,alpha_max,feasible)
+        call constrain_process_margin(n_per_q_c_max*q_fixed(1)-n_fixed(1), &
+             n_per_q_c_max*q_process(1)-n_process(1), &
+             alpha_min,alpha_max,feasible)
+      endif
+      if (q_trial(2).gt.qmin .and. n_trial(2).gt.0.0) then
+        call constrain_process_margin(n_fixed(2)-n_per_q_i_min*q_fixed(2), &
+             n_process(2)-n_per_q_i_min*q_process(2), &
+             alpha_min,alpha_max,feasible)
+        call constrain_process_margin(n_per_q_i_max*q_fixed(2)-n_fixed(2), &
+             n_per_q_i_max*q_process(2)-n_process(2), &
+             alpha_min,alpha_max,feasible)
+      endif
+      call constrain_process_margin(bg_fixed-q_fixed(5)/rho_max, &
+           bg_process-q_process(5)/rho_max,alpha_min,alpha_max,feasible)
+      call constrain_process_margin(q_fixed(5)/rho_min-bg_fixed, &
+           q_process(5)/rho_min-bg_process,alpha_min,alpha_max,feasible)
+      if (alpha_min.gt.alpha_max) feasible=.false.
+      if (.not.feasible) return
+
+      q_trial=q_fixed+alpha_max*q_process
+      n_trial=n_fixed+alpha_max*n_process
+      bg_trial=bg_fixed+alpha_max*bg_process
+      t_trial=t_fixed+alpha_max*t_process
+      if (alpha_min.gt.alpha_max) feasible=.false.
+      if (.not.feasible) return
+
+      fraction=max(0.0,min(1.0,alpha_max))
+      do step=1,8
+        q_trial=q_fixed+fraction*q_process
+        n_trial=n_fixed+fraction*n_process
+        bg_trial=bg_fixed+fraction*bg_process
+        t_trial=t_fixed+fraction*t_process
+        feasible=all(ieee_is_finite([q_trial,n_trial,bg_trial,t_trial]))
+        feasible=feasible .and. all(q_trial.ge.0.0) .and. all(n_trial.ge.0.0)
+        feasible=feasible .and. bg_trial.ge.0.0
+        do i=3,5
+          if (q_trial(i).gt.0.0 .and. q_trial(i).le.qcrmin) feasible=.false.
+        enddo
+        if (q_trial(1).gt.0.0 .and. q_trial(1).le.qmin) feasible=.false.
+        if (q_trial(2).gt.0.0 .and. q_trial(2).le.qmin) feasible=.false.
+        if (q_trial(1).le.qmin .and. n_trial(1).gt.0.0) feasible=.false.
+        if (q_trial(2).le.qmin .and. n_trial(2).gt.0.0) feasible=.false.
+        if (q_trial(1).gt.qmin .and. n_trial(1).le.0.0) feasible=.false.
+        if (q_trial(2).gt.qmin .and. n_trial(2).le.0.0) feasible=.false.
+        if (q_trial(3).gt.0.0) then
+          if (n_trial(3).lt.n_per_q_min*q_trial(3) .or. &
+              n_trial(3).gt.n_per_q_max*q_trial(3)) feasible=.false.
+        endif
+        if (q_trial(1).gt.qmin .and. n_trial(1).gt.0.0) then
+          if (n_trial(1).lt.n_per_q_c_min*q_trial(1) .or. &
+              n_trial(1).gt.n_per_q_c_max*q_trial(1)) feasible=.false.
+      endif
+        if (q_trial(2).gt.qmin .and. n_trial(2).gt.0.0) then
+          if (n_trial(2).lt.n_per_q_i_min*q_trial(2) .or. &
+              n_trial(2).gt.n_per_q_i_max*q_trial(2)) feasible=.false.
+      endif
+        if (bg_trial.lt.q_trial(5)/rho_max .or. &
+            bg_trial.gt.q_trial(5)/rho_min) feasible=.false.
+        if (feasible) exit
+        fraction=nearest(fraction,-1.0)
+        if (fraction.lt.alpha_min) exit
+      enddo
+      if (.not.feasible) fraction=0.0
+    end subroutine kdm6_rain_process_fraction
+
+    subroutine constrain_process_margin(margin_initial,margin_process, &
+         alpha_min,alpha_max,feasible)
+      implicit none
+      real, intent(in) :: margin_initial,margin_process
+      real, intent(inout) :: alpha_min,alpha_max
+      logical, intent(inout) :: feasible
+      real :: boundary
+
+      if (.not.feasible) return
+      if (margin_process.eq.0.0) then
+        if (margin_initial.lt.0.0) feasible=.false.
+      elseif (margin_process.gt.0.0) then
+        boundary=-margin_initial/margin_process
+        alpha_min=max(alpha_min,boundary)
+      else
+        boundary=-margin_initial/margin_process
+        alpha_max=min(alpha_max,boundary)
+      endif
+    end subroutine constrain_process_margin
+
+    real function kdm6_shared_pair_fraction(mass_rate_start,mass_rate_limited, &
+         number_rate_start,number_rate_limited)
+      use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+      implicit none
+      real, intent(in) :: mass_rate_start,mass_rate_limited
+      real, intent(in) :: number_rate_start,number_rate_limited
+      kdm6_shared_pair_fraction=1.0
+      if (.not.all(ieee_is_finite([mass_rate_start,mass_rate_limited, &
+          number_rate_start,number_rate_limited]))) then
+        error stop 'KDM6 paired process limiter received a nonfinite rate'
+      endif
+      if (mass_rate_start.lt.0.0 .or. mass_rate_limited.lt.0.0 .or. &
+          number_rate_start.lt.0.0 .or. number_rate_limited.lt.0.0 .or. &
+          mass_rate_limited.gt.mass_rate_start .or. &
+          number_rate_limited.gt.number_rate_start) then
+        error stop 'KDM6 paired process limiter changed a nonnegative rate inconsistently'
+      endif
+      if (mass_rate_start.gt.0.0) then
+        kdm6_shared_pair_fraction=min(kdm6_shared_pair_fraction, &
+             mass_rate_limited/mass_rate_start)
+      endif
+      if (number_rate_start.gt.0.0) then
+        kdm6_shared_pair_fraction=min(kdm6_shared_pair_fraction, &
+             number_rate_limited/number_rate_start)
+      endif
+    end function kdm6_shared_pair_fraction
+
