+SUBROUTINE pr67_qc_rk_before(rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte, &
+     qc,qc_base,qc_phys_tend,qc_advect_tend,msfty,c1,c2,mu_old,mu_new,mu_base,dt, &
+     qc_bl_tend,qc_cu_tend,qc_sh_tend,qc_nc_tend,qc_ns_tend)
+  implicit none
+  integer,intent(in)::rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte
+  real,intent(in)::qc(ims:ime,kms:kme,jms:jme),qc_base(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::qc_phys_tend(ims:ime,kms:kme,jms:jme),qc_advect_tend(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::msfty(ims:ime,jms:jme),c1(kms:kme),c2(kms:kme)
+  real,intent(in)::mu_old(ims:ime,jms:jme),mu_new(ims:ime,jms:jme),mu_base(ims:ime,jms:jme),dt
+  real,intent(in)::qc_bl_tend(ims:ime,kms:kme,jms:jme),qc_cu_tend(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::qc_sh_tend(ims:ime,kms:kme,jms:jme),qc_nc_tend(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::qc_ns_tend(ims:ime,kms:kme,jms:jme)
+  integer::i,j,k,u
+  real::base_q,adv_term,total_tend,old_mass,new_mass,predicted_q
+  if(rkstep<1 .or. rkstep>3) return
+  open(newunit=u,file='pr67_qc_rk.raw',status='unknown',position='append',action='write')
+  do j=jts,jte
+    do k=kts,kte
+      do i=its,ite
+        base_q=qc_base(i,k,j)
+        if(rkstep==1) base_q=qc(i,k,j)
+        adv_term=qc_advect_tend(i,k,j)*msfty(i,j)
+        total_tend=adv_term+qc_phys_tend(i,k,j)
+        old_mass=c1(k)*(mu_old(i,j)+mu_base(i,j))+c2(k)
+        new_mass=c1(k)*(mu_new(i,j)+mu_base(i,j))+c2(k)
+        predicted_q=(old_mass*base_q+dt*total_tend)/new_mass
+        if(qc(i,k,j)>=0. .and. predicted_q<0.) then
+          write(u,'(A,1X,I0,1X,3(I0,1X),21(ES24.16,1X))') 'QC_PRE',rkstep,i,j,k, &
+               qc(i,k,j),base_q,qc_advect_tend(i,k,j),msfty(i,j),adv_term, &
+               qc_phys_tend(i,k,j),qc_bl_tend(i,k,j),qc_cu_tend(i,k,j), &
+               qc_sh_tend(i,k,j),qc_nc_tend(i,k,j),qc_ns_tend(i,k,j),total_tend,dt, &
+               c1(k),c2(k),mu_old(i,j),mu_new(i,j),mu_base(i,j),old_mass,new_mass,predicted_q
+        endif
+      enddo
+    enddo
+  enddo
+  close(u)
+END SUBROUTINE pr67_qc_rk_before
+
+SUBROUTINE pr67_qc_rk_after(stage,rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte,qc)
+  implicit none
+  character(len=*),intent(in)::stage
+  integer,intent(in)::rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte
+  real,intent(in)::qc(ims:ime,kms:kme,jms:jme)
+  integer::i,j,k,u
+  if(rkstep<1 .or. rkstep>3) return
+  open(newunit=u,file='pr67_qc_rk.raw',status='unknown',position='append',action='write')
+  do j=jts,jte
+    do k=kts,kte
+      do i=its,ite
+        if(qc(i,k,j)<0.) write(u,'(A,1X,A,1X,I0,1X,3(I0,1X),ES24.16)') &
+             'QC_POST',trim(stage),rkstep,i,j,k,qc(i,k,j)
+      enddo
+    enddo
+  enddo
+  close(u)
+END SUBROUTINE pr67_qc_rk_after
+
