+SUBROUTINE pr64_host_cut(stage,rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte, &
+     species,partner_id,field,partner,old,new,tend,adv,msfty,c1,c2,muold,munew,mub,dt)
+  implicit none
+  character(len=*),intent(in)::stage
+  integer,intent(in)::rkstep,ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte,species,partner_id
+  real,intent(in)::field(ims:ime,kms:kme,jms:jme),partner(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::old(ims:ime,kms:kme,jms:jme),new(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::tend(ims:ime,kms:kme,jms:jme),adv(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::msfty(ims:ime,jms:jme),c1(kms:kme),c2(kms:kme)
+  real,intent(in)::muold(ims:ime,jms:jme),munew(ims:ime,jms:jme),mub(ims:ime,jms:jme),dt
+  integer::i,j,u
+  if(rkstep<1 .or. rkstep>3) return
+  if(172<its .or. 172>ite .or. 76<jts .or. 76>jte .or. 1<kts .or. 1>kte) return
+  open(newunit=u,file='pr64_host_neighborhood.raw',status='unknown',position='append',action='write')
+  do j=max(75,jts),min(77,jte)
+    do i=max(171,its),min(173,ite)
+      write(u,'(A,1X,A,1X,I0,5(1X,I0),15(1X,ES24.16))') &
+          'HOST',trim(stage),rkstep,i,j,1,species,partner_id, &
+          field(i,1,j),partner(i,1,j),old(i,1,j),new(i,1,j), &
+          tend(i,1,j),adv(i,1,j),msfty(i,j),c1(1),c2(1), &
+          muold(i,j),munew(i,j),mub(i,j),dt, &
+          c1(1)*(muold(i,j)+mub(i,j))+c2(1), &
+          c1(1)*(munew(i,j)+mub(i,j))+c2(1)
+    enddo
+  enddo
+  close(u)
+END SUBROUTINE pr64_host_cut
+
+SUBROUTINE pr64_qc_channels(rkstep,bl,cu,shcu,diff_opt,km_opt, &
+     ims,ime,jms,jme,kms,kme,qc_tend,qc_bl,qc_cu,qc_sh,qnc_cu,qnc_sh)
+  implicit none
+  integer,intent(in)::rkstep,bl,cu,shcu,diff_opt,km_opt
+  integer,intent(in)::ims,ime,jms,jme,kms,kme
+  real,intent(in)::qc_tend(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::qc_bl(ims:ime,kms:kme,jms:jme),qc_cu(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::qc_sh(ims:ime,kms:kme,jms:jme)
+  real,intent(in)::qnc_cu(ims:ime,kms:kme,jms:jme),qnc_sh(ims:ime,kms:kme,jms:jme)
+  integer::i,j,u
+  if(172<ims .or. 172>ime .or. 76<jms .or. 76>jme .or. 1<kms .or. 1>kme) return
+  open(newunit=u,file='pr64_qc_channels.raw',status='unknown',position='append',action='write')
+  write(u,'(A)') 'QCCHAN rkstep i j k bl_pbl cu shcu diff_opt km_opt qc_moist_tend rqcblten rqccuten rqcshten rqcncuten rqcnshten'
+  do j=max(75,jms),min(77,jme)
+    do i=max(171,ims),min(173,ime)
+      write(u,'(A,1X,9(I0,1X),6(ES24.16,1X))') 'QCCHAN',rkstep,i,j,1,bl,cu,shcu,diff_opt,km_opt, &
+           qc_tend(i,1,j),qc_bl(i,1,j),qc_cu(i,1,j),qc_sh(i,1,j),qnc_cu(i,1,j),qnc_sh(i,1,j)
+    enddo
+  enddo
+  close(u)
+END SUBROUTINE pr64_qc_channels
